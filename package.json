{
  "name": "qimu-workbench",
  "version": "0.1.7",
  "description": "栖木工作台 — 一个安静、本地优先的桌面效率空间",
  "main": "./out/main/index.js",
  "author": "Workbench",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "pnpm run typecheck && electron-vite build",
    "package:win": "pnpm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "dompurify": "3.4.17",
    "lucide-react": "0.552.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "com.qimu.workbench",
    "productName": "栖木工作台",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Qimu.Workbench.Markdown",
        "description": "Markdown 文档",
        "icon": "icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "栖木工作台",
      "include": "installer.nsh"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  }
}
